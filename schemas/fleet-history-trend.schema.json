{
  "$defs": {
    "FindingTrend": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "first_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Observed At"
        },
        "last_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed At"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "new",
            "persistent",
            "changed",
            "blocked",
            "not_observed",
            "not_comparable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "resource_id",
        "state"
      ],
      "title": "FindingTrend",
      "type": "object"
    },
    "FleetFindingRecurrence": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "first_observed_at": {
          "format": "date-time",
          "title": "First Observed At",
          "type": "string"
        },
        "last_observed_at": {
          "format": "date-time",
          "title": "Last Observed At",
          "type": "string"
        },
        "observed_runs": {
          "minimum": 2,
          "title": "Observed Runs",
          "type": "integer"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "resource_id",
        "observed_runs",
        "first_observed_at",
        "last_observed_at"
      ],
      "title": "FleetFindingRecurrence",
      "type": "object"
    },
    "FleetHistorySeries": {
      "additionalProperties": false,
      "properties": {
        "cluster_resource_id": {
          "title": "Cluster Resource Id",
          "type": "string"
        },
        "cluster_uid": {
          "title": "Cluster Uid",
          "type": "string"
        },
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "comparisons": {
          "items": {
            "$ref": "#/$defs/HistoryTrend"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "peer_group": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Peer Group",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "insufficient_samples",
              "comparison_basis_changed"
            ],
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "recurring_findings": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FleetFindingRecurrence"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recurring Findings"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/HistoryRun"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Runs",
          "type": "array"
        }
      },
      "required": [
        "cluster_resource_id",
        "cluster_uid",
        "peer_group",
        "runs",
        "comparisons",
        "comparable",
        "reason_codes",
        "recurring_findings"
      ],
      "title": "FleetHistorySeries",
      "type": "object"
    },
    "HistoryRun": {
      "additionalProperties": false,
      "properties": {
        "blocked_recommendations": {
          "minimum": 0,
          "title": "Blocked Recommendations",
          "type": "integer"
        },
        "comparison_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Comparison Key",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "recommendations": {
          "minimum": 0,
          "title": "Recommendations",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Id",
          "type": "string"
        },
        "savings": {
          "default": null,
          "title": "Savings",
          "type": "null"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "tenant_id",
        "generated_at",
        "window_start",
        "window_end",
        "status",
        "snapshot_digest",
        "configuration_digest",
        "comparison_key",
        "recommendations",
        "blocked_recommendations"
      ],
      "title": "HistoryRun",
      "type": "object"
    },
    "HistoryTrend": {
      "additionalProperties": false,
      "properties": {
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "current_run_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Run Id",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/FindingTrend"
          },
          "title": "Findings",
          "type": "array"
        },
        "previous_run_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Previous Run Id",
          "type": "string"
        },
        "savings": {
          "default": null,
          "title": "Savings",
          "type": "null"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "previous_run_id",
        "current_run_id",
        "comparable",
        "findings"
      ],
      "title": "HistoryTrend",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "estimated_monthly_savings": {
      "default": null,
      "title": "Estimated Monthly Savings",
      "type": "null"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/FleetHistorySeries"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Series",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "series"
  ],
  "title": "FleetHistoryTrend",
  "type": "object"
}
