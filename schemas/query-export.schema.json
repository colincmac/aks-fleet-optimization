{
  "$defs": {
    "PackParameters": {
      "additionalProperties": false,
      "properties": {
        "review_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Ratio"
        }
      },
      "title": "PackParameters",
      "type": "object"
    },
    "PackProvenance": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^AKS-[A-Z]+-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/PackParameters"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/QueryAsset"
          },
          "title": "Queries",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "parameters",
        "queries"
      ],
      "title": "PackProvenance",
      "type": "object"
    },
    "QueryAsset": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "boolean"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "container",
            "workload_container",
            "unresolved_container",
            "node",
            "workload",
            "hpa"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mCPU",
            "MiB",
            "ratio",
            "events",
            "pods",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit",
        "kind",
        "delta",
        "expression"
      ],
      "title": "QueryAsset",
      "type": "object"
    },
    "RenderedQuery": {
      "additionalProperties": false,
      "properties": {
        "entity_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Entity Digest",
          "type": "string"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "expression_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expression Digest",
          "type": "string"
        },
        "metric": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Step Seconds",
          "type": "integer"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "version",
        "source",
        "expression",
        "expression_digest",
        "entity_digest",
        "step_seconds"
      ],
      "title": "RenderedQuery",
      "type": "object"
    },
    "SourceDefinition": {
      "additionalProperties": false,
      "properties": {
        "characterization": {
          "const": "synthetic",
          "title": "Characterization",
          "type": "string"
        },
        "characterized_versions": {
          "additionalProperties": {
            "items": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "prometheus",
              "kube-state-metrics",
              "cadvisor",
              "kubernetes"
            ]
          },
          "title": "Characterized Versions",
          "type": "object"
        },
        "id": {
          "enum": [
            "identity-enriched",
            "cadvisor-ksm"
          ],
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "enum": [
            "historical",
            "name-only"
          ],
          "title": "Identity",
          "type": "string"
        },
        "joins": {
          "const": "none",
          "title": "Joins",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "query_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Ids",
          "type": "array"
        },
        "transports": {
          "items": {
            "enum": [
              "prometheus",
              "azure-managed-prometheus"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "identity",
        "transports",
        "labels",
        "query_ids",
        "characterized_versions",
        "characterization",
        "joins",
        "limitations"
      ],
      "title": "SourceDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "baseline",
        "guarded"
      ],
      "title": "Mode",
      "type": "string"
    },
    "notice": {
      "const": "Query export does not attest source history or authorize a change.",
      "default": "Query export does not attest source history or authorize a change.",
      "title": "Notice",
      "type": "string"
    },
    "pack": {
      "$ref": "#/$defs/PackProvenance"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/RenderedQuery"
      },
      "minItems": 1,
      "title": "Queries",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_profile": {
      "$ref": "#/$defs/SourceDefinition"
    }
  },
  "required": [
    "mode",
    "pack",
    "queries",
    "source_profile"
  ],
  "title": "QueryExportManifest",
  "type": "object"
}
