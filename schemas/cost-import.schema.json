  "additionalProperties": false,
  "properties": {
    "allocation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostAllocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/CostResourceBinding"
      },
      "maxItems": 100000,
      "title": "Bindings",
      "type": "array"
    },
    "cost_basis": {
      "enum": [
        "actual",
        "amortized",
        "effective"
      ],
      "title": "Cost Basis",
      "type": "string"
    },
    "export_complete": {
      "default": false,
      "title": "Export Complete",
      "type": "boolean"
    },
    "export_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostExportProvenance"
        },
        {
          "type": "null"
        }
