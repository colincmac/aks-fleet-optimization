        "profile",
        "source_reference",
        "cost_basis",
        "period",
        "complete",
        "allocation_policy"
      ],
      "title": "CostAllocation",
      "type": "object"
    },
    "CostExportFile": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "partition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Partition Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "partition_sha256",
        "sha256",
        "byte_count",
        "row_count"
      ],
      "title": "CostExportFile",
      "type": "object"
    },
    "CostExportProvenance": {
      "additionalProperties": false,
      "properties": {
        "effective_cost_totals": {
          "maxProperties": 100,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Z]{3}$": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 12,
              "max_digits": 30
            }
          },
          "title": "Effective Cost Totals",
          "type": "object"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CostExportFile"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "run_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Id Sha256",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "run_id_sha256",
        "files",
        "effective_cost_totals"
      ],
      "title": "CostExportProvenance",
      "type": "object"
    },
    "CostPeriod": {
      "additionalProperties": false,
      "properties": {
