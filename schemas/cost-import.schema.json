    "CostAllocation": {
      "additionalProperties": false,
      "properties": {
        "allocation_policy": {
          "enum": [
            "not-shared",
            "source-native"
          ],
          "title": "Allocation Policy",
          "type": "string"
        },
        "amounts": {
          "items": {
            "$ref": "#/$defs/AggregateAllocation"
          },
          "maxItems": 100000,
          "title": "Amounts",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "cost_basis": {
          "enum": [
            "actual",
            "amortized",
            "effective"
          ],
          "title": "Cost Basis",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "pricing_basis": {
          "default": "source-declared",
          "enum": [
            "billing-ledger",
            "source-declared"
          ],
          "title": "Pricing Basis",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/FinancialProfileReference"
        },
        "shares": {
          "items": {
            "$ref": "#/$defs/AllocationShare"
          },
          "maxItems": 100000,
          "title": "Shares",
          "type": "array"
        },
        "source_reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        }
