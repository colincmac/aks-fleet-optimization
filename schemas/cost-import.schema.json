{
  "$defs": {
    "AllocationShare": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "allocated",
            "idle",
            "system",
            "unallocated"
          ],
          "title": "Category",
          "type": "string"
        },
        "container": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 18,
          "ge": 0,
          "le": 1,
          "max_digits": 19,
          "title": "Fraction"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "row_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Row Id",
          "type": "string"
        },
        "workload_uid": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Uid"
        }
      },
      "required": [
        "row_id",
        "fraction",
        "category"
      ],
      "title": "AllocationShare",
      "type": "object"
    },
    "CostAllocation": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "reviewed-shares",
          "title": "Basis",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "profile": {
          "const": "reviewed-allocation-shares-v1",
          "default": "reviewed-allocation-shares-v1",
          "title": "Profile",
          "type": "string"
        },
        "shared_idle": {
          "const": false,
          "title": "Shared Idle",
          "type": "boolean"
        },
        "shares": {
          "items": {
            "$ref": "#/$defs/AllocationShare"
          },
          "maxItems": 100000,
          "title": "Shares",
          "type": "array"
        },
        "source": {
          "enum": [
            "aks-cost-analysis",
            "opencost",
            "kubecost"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_reference",
        "basis",
        "shared_idle",
        "period",
        "shares"
      ],
      "title": "CostAllocation",
      "type": "object"
    },
    "CostPeriod": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CostPeriod",
      "type": "object"
    },
    "CostResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "cluster_resource_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cluster Resource Id",
          "type": "string"
        },
        "cluster_uid": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cluster Uid",
          "type": "string"
        },
        "pool_resource_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pool Resource Id"
        },
        "reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reference",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "cluster_resource_id",
        "cluster_uid",
        "reference"
      ],
      "title": "CostResourceBinding",
      "type": "object"
    },
    "CostRow": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 12,
          "max_digits": 30,
          "title": "Amount"
        },
        "benefit_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benefit Id"
        },
        "charge_category": {
          "enum": [
            "compute",
            "storage",
            "network",
            "other"
          ],
          "title": "Charge Category",
          "type": "string"
        },
        "charge_type": {
          "enum": [
            "Usage",
            "Purchase",
            "Refund",
            "UnusedReservation",
            "UnusedSavingsPlan",
            "RoundingAdjustment"
          ],
          "title": "Charge Type",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "pricing_model": {
          "enum": [
            "OnDemand",
            "Reservation",
            "SavingsPlan",
            "Spot"
          ],
          "title": "Pricing Model",
          "type": "string"
        },
        "reservation_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Id"
        },
        "subscription_id": {
          "format": "uuid",
          "title": "Subscription Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "subscription_id",
        "resource_id",
        "period",
        "amount",
        "currency",
        "charge_category",
        "charge_type",
        "pricing_model"
      ],
      "title": "CostRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allocation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostAllocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/CostResourceBinding"
      },
      "maxItems": 100000,
      "title": "Bindings",
      "type": "array"
    },
    "cost_basis": {
      "const": "amortized",
      "title": "Cost Basis",
      "type": "string"
    },
    "export_complete": {
      "default": false,
      "title": "Export Complete",
      "type": "boolean"
    },
    "period": {
      "$ref": "#/$defs/CostPeriod"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/CostRow"
      },
      "maxItems": 100000,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_observed_at": {
      "format": "date-time",
      "title": "Source Observed At",
      "type": "string"
    },
    "source_profile": {
      "const": "azure-cost-details-projection-v1",
      "title": "Source Profile",
      "type": "string"
    },
    "source_reference": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Reference",
      "type": "string"
    },
    "subscription_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Subscription Ids",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "source_profile",
    "cost_basis",
    "tenant_id",
    "subscription_ids",
    "period",
    "source_reference",
    "source_observed_at",
    "rows"
  ],
  "title": "CostImport",
  "type": "object"
}
