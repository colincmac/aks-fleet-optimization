        "charge_type": {
          "enum": [
            "Usage",
            "Purchase",
            "Refund",
            "UnusedReservation",
            "UnusedSavingsPlan",
            "RoundingAdjustment",
            "Tax",
            "Credit",
            "Adjustment"
