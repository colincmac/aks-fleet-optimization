      "required": [
        "id",
        "subscription_id",
        "resource_id",
        "period",
        "amount",
        "currency",
        "charge_category",
        "source_category",
        "charge_type",
        "pricing_model"
      ],
      "title": "CostRow",
      "type": "object"
    },
    "FinancialProfileReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._()-]{0,127}$",
          "title": "Producer Version",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "producer_version"
      ],
      "title": "FinancialProfileReference",
      "type": "object"
    },
