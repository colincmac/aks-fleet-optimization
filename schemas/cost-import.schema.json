        "cluster_uid": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cluster Uid",
          "type": "string"
        },
        "identity_basis": {
          "const": "exact-historical",
          "title": "Identity Basis",
          "type": "string"
        },
        "pool_resource_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
