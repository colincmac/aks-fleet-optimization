{
  "$defs": {
    "CollectionError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unauthorized",
            "forbidden",
            "timeout",
            "throttled",
            "unavailable",
            "invalid-response",
            "response-budget-exceeded",
            "identity-mismatch"
          ],
          "title": "Code",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "code"
      ],
      "title": "CollectionError",
      "type": "object"
    },
    "CollectionStatus": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "CollectionStatus",
      "type": "string"
    },
    "CollectorResult": {
      "additionalProperties": false,
      "properties": {
        "collector": {
          "minLength": 1,
          "title": "Collector",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "completed_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Scope",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/CollectionError"
          },
          "title": "Errors",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "pagination_complete": {
          "default": false,
          "title": "Pagination Complete",
          "type": "boolean"
        },
        "requested_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Scope",
          "type": "array"
        },
        "retry_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Observed At"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CollectionStatus"
        }
      },
      "required": [
        "collector",
        "status",
        "requested_scope",
        "started_at",
        "completed_at"
      ],
      "title": "CollectorResult",
      "type": "object"
    },
    "MetricEntity": {
      "additionalProperties": false,
      "properties": {
        "cluster_resource_id": {
          "minLength": 1,
          "title": "Cluster Resource Id",
          "type": "string"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "hpa_uid": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hpa Uid"
        },
        "kind": {
          "default": "container",
          "enum": [
            "container",
            "workload",
            "workload_container",
            "hpa",
            "node",
            "node_pool",
            "unresolved_container"
          ],
          "title": "Kind",
          "type": "string"
        },
        "membership_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Digest"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "node_pool_resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Pool Resource Id"
        },
        "node_resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Resource Id"
        },
        "node_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Uid"
        },
        "pod": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pod"
        },
        "pod_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pod Uid"
        },
        "workload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload"
        },
        "workload_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Kind"
        },
        "workload_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Uid"
        }
      },
      "required": [
        "cluster_resource_id"
      ],
      "title": "MetricEntity",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/MetricEntity"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "latest_sample_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Sample At"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95"
        },
        "p99": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P99"
        },
        "quality": {
          "$ref": "#/$defs/MetricQuality"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "entity",
        "metric",
        "quality"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "MetricQuality": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "query_expression": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Expression"
        },
        "query_version": {
          "minLength": 1,
          "title": "Query Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "title": "Step Seconds",
          "type": "integer"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/MetricWindow"
        }
      },
      "required": [
        "source",
        "query_version",
        "step_seconds",
        "observed_at",
        "window",
        "unit"
      ],
      "title": "MetricQuality",
      "type": "object"
    },
    "MetricQueryPlan": {
      "additionalProperties": false,
      "properties": {
        "expected_evaluations": {
          "minimum": 0,
          "title": "Expected Evaluations",
          "type": "integer"
        },
        "logical_queries": {
          "minimum": 0,
          "title": "Logical Queries",
          "type": "integer"
        },
        "maximum_series": {
          "minimum": 1,
          "title": "Maximum Series",
          "type": "integer"
        },
        "requests": {
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "unique_queries": {
          "minimum": 0,
          "title": "Unique Queries",
          "type": "integer"
        }
      },
      "required": [
        "logical_queries",
        "unique_queries",
        "requests",
        "expected_evaluations",
        "maximum_series"
      ],
      "title": "MetricQueryPlan",
      "type": "object"
    },
    "MetricWindow": {
      "additionalProperties": false,
      "properties": {
        "coverage_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "sample_count",
        "coverage_ratio"
      ],
      "title": "MetricWindow",
      "type": "object"
    },
    "SourceDefinition": {
      "additionalProperties": false,
      "properties": {
        "characterization": {
          "const": "synthetic",
          "title": "Characterization",
          "type": "string"
        },
        "characterized_versions": {
          "additionalProperties": {
            "items": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "prometheus",
              "kube-state-metrics",
              "cadvisor",
              "kubernetes"
            ]
          },
          "title": "Characterized Versions",
          "type": "object"
        },
        "id": {
          "enum": [
            "identity-enriched",
            "cadvisor-ksm"
          ],
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "enum": [
            "historical",
            "name-only"
          ],
          "title": "Identity",
          "type": "string"
        },
        "joins": {
          "const": "none",
          "title": "Joins",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "query_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Ids",
          "type": "array"
        },
        "transports": {
          "items": {
            "enum": [
              "prometheus",
              "azure-managed-prometheus"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "identity",
        "transports",
        "labels",
        "query_ids",
        "characterized_versions",
        "characterization",
        "joins",
        "limitations"
      ],
      "title": "SourceDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collection": {
      "$ref": "#/$defs/CollectorResult"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/MetricObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "query_end": {
      "format": "date-time",
      "title": "Query End",
      "type": "string"
    },
    "query_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricQueryPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "query_start": {
      "format": "date-time",
      "title": "Query Start",
      "type": "string"
    },
    "query_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Query Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "prometheus",
      "default": "prometheus",
      "title": "Source",
      "type": "string"
    },
    "source_name": {
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    },
    "source_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "step_seconds": {
      "exclusiveMinimum": 0,
      "title": "Step Seconds",
      "type": "integer"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "source_name",
    "generated_at",
    "query_start",
    "query_end",
    "step_seconds",
    "collection",
    "observations"
  ],
  "title": "PrometheusMetricsSnapshot",
  "type": "object"
}
