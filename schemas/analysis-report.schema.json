{
  "$defs": {
    "AnalysisSummary": {
      "additionalProperties": false,
      "properties": {
        "blocked_recommendations": {
          "default": 0,
          "title": "Blocked Recommendations",
          "type": "integer"
        },
        "clusters_analyzed": {
          "title": "Clusters Analyzed",
          "type": "integer"
        },
        "data_quality_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Data Quality Warnings",
          "type": "array"
        },
        "high_or_critical": {
          "title": "High Or Critical",
          "type": "integer"
        },
        "node_pools_analyzed": {
          "title": "Node Pools Analyzed",
          "type": "integer"
        },
        "recommendations": {
          "title": "Recommendations",
          "type": "integer"
        },
        "workloads_analyzed": {
          "title": "Workloads Analyzed",
          "type": "integer"
        }
      },
      "required": [
        "clusters_analyzed",
        "node_pools_analyzed",
        "workloads_analyzed",
        "recommendations",
        "high_or_critical"
      ],
      "title": "AnalysisSummary",
      "type": "object"
    },
    "BlockedRecommendation": {
      "additionalProperties": false,
      "properties": {
        "cluster_name": {
          "title": "Cluster Name",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "workload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload"
        }
      },
      "required": [
        "id",
        "rule_id",
        "rule_version",
        "resource_id",
        "cluster_name",
        "reason_codes"
      ],
      "title": "BlockedRecommendation",
      "type": "object"
    },
    "CapabilityCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "reason_codes"
      ],
      "title": "CapabilityCheck",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric",
        "value",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MetricWindow": {
      "additionalProperties": false,
      "properties": {
        "coverage_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "sample_count",
        "coverage_ratio"
      ],
      "title": "MetricWindow",
      "type": "object"
    },
    "PackParameters": {
      "additionalProperties": false,
      "properties": {
        "review_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Ratio"
        }
      },
      "title": "PackParameters",
      "type": "object"
    },
    "PackProvenance": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^AKS-[A-Z]+-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/PackParameters"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/QueryAsset"
          },
          "title": "Queries",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "parameters",
        "queries"
      ],
      "title": "PackProvenance",
      "type": "object"
    },
    "QueryAsset": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "boolean"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "container",
            "workload_container",
            "unresolved_container",
            "node",
            "workload",
            "hpa"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mCPU",
            "MiB",
            "ratio",
            "events",
            "pods",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit",
        "kind",
        "delta",
        "expression"
      ],
      "title": "QueryAsset",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "cluster_name": {
          "title": "Cluster Name",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "current_limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_replica_floor": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Replica Floor"
        },
        "current_requests": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRequests"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimated_monthly_savings": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Monthly Savings"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "proposed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Actions",
          "type": "array"
        },
        "proposed_limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposed_replica_floor": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Replica Floor"
        },
        "proposed_requests": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRequests"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "rollback_steps": {
          "items": {
            "type": "string"
          },
          "title": "Rollback Steps",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "validation_steps": {
          "items": {
            "type": "string"
          },
          "title": "Validation Steps",
          "type": "array"
        },
        "workload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload"
        }
      },
      "required": [
        "id",
        "rule_id",
        "rule_version",
        "title",
        "summary",
        "resource_id",
        "cluster_name",
        "severity",
        "confidence",
        "category",
        "evidence"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "memory_mib": {
          "exclusiveMinimum": 0,
          "title": "Memory Mib",
          "type": "number"
        }
      },
      "required": [
        "memory_mib"
      ],
      "title": "ResourceLimits",
      "type": "object"
    },
    "ResourceRequests": {
      "additionalProperties": false,
      "properties": {
        "cpu_mcores": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Mcores"
        },
        "memory_mib": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mib"
        }
      },
      "title": "ResourceRequests",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceCapability": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CapabilityCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "cluster_resource_id": {
          "minLength": 1,
          "title": "Cluster Resource Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "baseline",
            "guarded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "notice": {
          "const": "Metric capability is not source attestation or safe-change approval.",
          "default": "Metric capability is not source attestation or safe-change approval.",
          "title": "Notice",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "pack_id": {
          "minLength": 1,
          "title": "Pack Id",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_profile": {
          "$ref": "#/$defs/SourceDefinition"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "pack_id",
        "mode",
        "source",
        "cluster_resource_id",
        "observed_at",
        "source_profile",
        "status",
        "checks"
      ],
      "title": "SourceCapability",
      "type": "object"
    },
    "SourceDefinition": {
      "additionalProperties": false,
      "properties": {
        "characterization": {
          "const": "synthetic",
          "title": "Characterization",
          "type": "string"
        },
        "characterized_versions": {
          "additionalProperties": {
            "items": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "prometheus",
              "kube-state-metrics",
              "cadvisor",
              "kubernetes"
            ]
          },
          "title": "Characterized Versions",
          "type": "object"
        },
        "id": {
          "enum": [
            "identity-enriched",
            "cadvisor-ksm"
          ],
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "enum": [
            "historical",
            "name-only"
          ],
          "title": "Identity",
          "type": "string"
        },
        "joins": {
          "const": "none",
          "title": "Joins",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "query_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Ids",
          "type": "array"
        },
        "transports": {
          "items": {
            "enum": [
              "prometheus",
              "azure-managed-prometheus"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "identity",
        "transports",
        "labels",
        "query_ids",
        "characterized_versions",
        "characterization",
        "joins",
        "limitations"
      ],
      "title": "SourceDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocked_recommendations": {
      "items": {
        "$ref": "#/$defs/BlockedRecommendation"
      },
      "title": "Blocked Recommendations",
      "type": "array"
    },
    "configuration_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Digest"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "mode": {
      "enum": [
        "baseline",
        "guarded"
      ],
      "title": "Mode",
      "type": "string"
    },
    "observation_window": {
      "$ref": "#/$defs/MetricWindow"
    },
    "pack_provenance": {
      "items": {
        "$ref": "#/$defs/PackProvenance"
      },
      "title": "Pack Provenance",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Digest"
    },
    "source_capabilities": {
      "items": {
        "$ref": "#/$defs/SourceCapability"
      },
      "title": "Source Capabilities",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/AnalysisSummary"
    }
  },
  "required": [
    "mode",
    "pack_provenance",
    "generated_at",
    "observation_window",
    "summary",
    "recommendations"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
