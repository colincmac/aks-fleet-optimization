{
  "$defs": {
    "NapBudgetCalculation": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active"
        },
        "applies_to": {
          "items": {
            "enum": [
              "Empty",
              "Underutilized",
              "Drifted",
              "Unhealthy"
            ],
            "type": "string"
          },
          "title": "Applies To",
          "type": "array"
        },
        "configured_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Configured Limit"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "index",
        "active",
        "applies_to",
        "configured_limit",
        "reason_codes"
      ],
      "title": "NapBudgetCalculation",
      "type": "object"
    },
    "NapReasonCalculation": {
      "additionalProperties": false,
      "properties": {
        "configured_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Configured Limit"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "configured_ceiling",
            "no_applicable_active_budget",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "configured_limit",
        "reason_codes"
      ],
      "title": "NapReasonCalculation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_disruption_headroom": {
      "const": "not_calculated",
      "default": "not_calculated",
      "title": "Actual Disruption Headroom",
      "type": "string"
    },
    "basis": {
      "const": "supplied_policy_reference_calculation",
      "default": "supplied_policy_reference_calculation",
      "title": "Basis",
      "type": "string"
    },
    "budgets": {
      "items": {
        "$ref": "#/$defs/NapBudgetCalculation"
      },
      "title": "Budgets",
      "type": "array"
    },
    "cluster_resource_id": {
      "title": "Cluster Resource Id",
      "type": "string"
    },
    "cluster_uid": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
      "title": "Cluster Uid",
      "type": "string"
    },
    "consolidation_interpretation": {
      "enum": [
        "configured_dynamic_policy",
        "disabled_by_never",
        "ignored_for_static_pool",
        "unknown"
      ],
      "title": "Consolidation Interpretation",
      "type": "string"
    },
    "controller_admission": {
      "const": "unverified",
      "default": "unverified",
      "title": "Controller Admission",
      "type": "string"
    },
    "disruption_feasibility": {
      "const": "unknown",
      "default": "unknown",
      "title": "Disruption Feasibility",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "nodepool_uid": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
      "title": "Nodepool Uid",
      "type": "string"
    },
    "reasons": {
      "additionalProperties": {
        "$ref": "#/$defs/NapReasonCalculation"
      },
      "propertyNames": {
        "enum": [
          "Empty",
          "Underutilized",
          "Drifted",
          "Unhealthy"
        ]
      },
      "title": "Reasons",
      "type": "object"
    },
    "reference": {
      "const": "azure-v1.15.2/karpenter-v1.15.1",
      "default": "azure-v1.15.2/karpenter-v1.15.1",
      "title": "Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_issues": {
      "items": {
        "type": "string"
      },
      "title": "Source Issues",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "input_digest",
    "tenant_id",
    "cluster_resource_id",
    "cluster_uid",
    "nodepool_uid",
    "evaluated_at",
    "source_issues",
    "budgets",
    "reasons",
    "consolidation_interpretation"
  ],
  "title": "NapPolicyReview",
  "type": "object"
}
