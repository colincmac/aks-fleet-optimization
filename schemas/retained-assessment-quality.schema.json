{
  "$defs": {
    "CollectionError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unauthorized",
            "forbidden",
            "timeout",
            "throttled",
            "unavailable",
            "invalid-response",
            "response-budget-exceeded",
            "identity-mismatch"
          ],
          "title": "Code",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "code"
      ],
      "title": "CollectionError",
      "type": "object"
    },
    "CollectionStatus": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "CollectionStatus",
      "type": "string"
    },
    "CollectorResult": {
      "additionalProperties": false,
      "properties": {
        "collector": {
          "minLength": 1,
          "title": "Collector",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "completed_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Scope",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/CollectionError"
          },
          "title": "Errors",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "pagination_complete": {
          "default": false,
          "title": "Pagination Complete",
          "type": "boolean"
        },
        "requested_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Scope",
          "type": "array"
        },
        "retry_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Observed At"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CollectionStatus"
        }
      },
      "required": [
        "collector",
        "status",
        "requested_scope",
        "started_at",
        "completed_at"
      ],
      "title": "CollectorResult",
      "type": "object"
    },
    "MetricQuality": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "query_asset_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Asset Version"
        },
        "query_expression": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Expression"
        },
        "query_version": {
          "minLength": 1,
          "title": "Query Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "title": "Step Seconds",
          "type": "integer"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/MetricWindow"
        }
      },
      "required": [
        "source",
        "query_version",
        "step_seconds",
        "observed_at",
        "window",
        "unit"
      ],
      "title": "MetricQuality",
      "type": "object"
    },
    "MetricWindow": {
      "additionalProperties": false,
      "properties": {
        "coverage_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "sample_count",
        "coverage_ratio"
      ],
      "title": "MetricWindow",
      "type": "object"
    },
    "RenderedQuery": {
      "additionalProperties": false,
      "properties": {
        "entity_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Entity Digest",
          "type": "string"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "expression_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expression Digest",
          "type": "string"
        },
        "metric": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Step Seconds",
          "type": "integer"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "version",
        "source",
        "expression",
        "expression_digest",
        "entity_digest",
        "step_seconds"
      ],
      "title": "RenderedQuery",
      "type": "object"
    },
    "RetainedQueryQuality": {
      "additionalProperties": false,
      "properties": {
        "latest_sample_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Sample At"
        },
        "observation_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Digest"
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query": {
          "$ref": "#/$defs/RenderedQuery"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "receipt_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Digest"
        },
        "source_profile_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Profile Digest"
        },
        "status": {
          "enum": [
            "matched",
            "unknown",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mCPU",
            "MiB",
            "ratio",
            "events",
            "pods",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "query",
        "unit",
        "status",
        "reason_codes"
      ],
      "title": "RetainedQueryQuality",
      "type": "object"
    },
    "SourceDefinition": {
      "additionalProperties": false,
      "properties": {
        "characterization": {
          "const": "synthetic",
          "title": "Characterization",
          "type": "string"
        },
        "characterized_versions": {
          "additionalProperties": {
            "items": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "prometheus",
              "kube-state-metrics",
              "cadvisor",
              "kubernetes"
            ]
          },
          "title": "Characterized Versions",
          "type": "object"
        },
        "id": {
          "enum": [
            "identity-enriched",
            "cadvisor-ksm"
          ],
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "enum": [
            "historical",
            "name-only"
          ],
          "title": "Identity",
          "type": "string"
        },
        "joins": {
          "const": "none",
          "title": "Joins",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "query_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Ids",
          "type": "array"
        },
        "transports": {
          "items": {
            "enum": [
              "prometheus",
              "azure-managed-prometheus"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "identity",
        "transports",
        "labels",
        "query_ids",
        "characterized_versions",
        "characterization",
        "joins",
        "limitations"
      ],
      "title": "SourceDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_status": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Assessment Status",
      "type": "string"
    },
    "basis": {
      "const": "retained-assessment",
      "default": "retained-assessment",
      "title": "Basis",
      "type": "string"
    },
    "cluster_resource_id": {
      "title": "Cluster Resource Id",
      "type": "string"
    },
    "cluster_uid": {
      "title": "Cluster Uid",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "live_quality": {
      "const": "unknown",
      "default": "unknown",
      "title": "Live Quality",
      "type": "string"
    },
    "notice": {
      "const": "Original retained execution only, not live datasource quality, source authentication, finding eligibility or change approval. Logical source names do not identify an endpoint.",
      "default": "Original retained execution only, not live datasource quality, source authentication, finding eligibility or change approval. Logical source names do not identify an endpoint.",
      "title": "Notice",
      "type": "string"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/CollectorResult"
      },
      "title": "Receipts",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/RetainedQueryQuality"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_profile": {
      "$ref": "#/$defs/SourceDefinition"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "evaluated_at",
    "cluster_resource_id",
    "cluster_uid",
    "window_start",
    "window_end",
    "assessment_status",
    "source_profile",
    "receipts",
    "records"
  ],
  "title": "RetainedAssessmentQuality",
  "type": "object"
}
