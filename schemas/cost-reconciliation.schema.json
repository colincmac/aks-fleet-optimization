        "resource_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Resource Id",
          "type": "string"
        },
        "valid_period": {
          "$ref": "#/$defs/CostPeriod"
        }
      },
      "required": [
        "resource_id",
        "cluster_resource_id",
        "cluster_uid",
        "valid_period",
        "identity_basis",
        "reference"
      ],
      "title": "CostResourceBinding",
      "type": "object"
