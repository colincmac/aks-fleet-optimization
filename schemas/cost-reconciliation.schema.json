      "title": "AllocationShare",
      "type": "object"
    },
    "CostAllocation": {
      "additionalProperties": false,
      "properties": {
        "allocation_policy": {
          "enum": [
            "not-shared",
            "source-native"
          ],
          "title": "Allocation Policy",
          "type": "string"
        },
        "amounts": {
          "items": {
            "$ref": "#/$defs/AggregateAllocation"
          },
          "maxItems": 100000,
          "title": "Amounts",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "cost_basis": {
          "enum": [
            "actual",
            "amortized",
            "effective"
          ],
          "title": "Cost Basis",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "pricing_basis": {
          "default": "source-declared",
          "enum": [
            "billing-ledger",
            "source-declared"
          ],
          "title": "Pricing Basis",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/FinancialProfileReference"
        },
        "shares": {
          "items": {
            "$ref": "#/$defs/AllocationShare"
          },
          "maxItems": 100000,
          "title": "Shares",
          "type": "array"
        },
        "source_reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "source_reference",
        "cost_basis",
        "period",
        "complete",
        "allocation_policy"
      ],
      "title": "CostAllocation",
      "type": "object"
    },
    "CostExportFile": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "partition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Partition Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "partition_sha256",
        "sha256",
        "byte_count",
        "row_count"
      ],
      "title": "CostExportFile",
      "type": "object"
    },
    "CostExportProvenance": {
      "additionalProperties": false,
      "properties": {
        "effective_cost_totals": {
          "maxProperties": 100,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Z]{3}$": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 12,
              "max_digits": 30
            }
          },
          "title": "Effective Cost Totals",
          "type": "object"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CostExportFile"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "run_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Id Sha256",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "run_id_sha256",
        "files",
        "effective_cost_totals"
      ],
      "title": "CostExportProvenance",
      "type": "object"
    },
    "CostImport": {
      "additionalProperties": false,
      "properties": {
        "allocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostAllocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/CostResourceBinding"
          },
          "maxItems": 100000,
          "title": "Bindings",
          "type": "array"
        },
        "cost_basis": {
          "enum": [
            "actual",
            "amortized",
            "effective"
          ],
          "title": "Cost Basis",
          "type": "string"
        },
        "export_complete": {
          "default": false,
          "title": "Export Complete",
          "type": "boolean"
        },
        "export_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostExportProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledger_profile": {
          "$ref": "#/$defs/FinancialProfileReference"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CostRow"
          },
          "maxItems": 100000,
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observed_at": {
          "format": "date-time",
          "title": "Source Observed At",
          "type": "string"
        },
        "source_reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        },
        "subscription_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Subscription Ids",
          "type": "array"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "ledger_profile",
        "cost_basis",
        "tenant_id",
        "subscription_ids",
        "period",
        "source_reference",
        "source_observed_at",
        "rows"
      ],
      "title": "CostImport",
      "type": "object"
    },
    "CostPeriod": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
