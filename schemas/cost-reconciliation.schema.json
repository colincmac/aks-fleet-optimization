{
  "$defs": {
    "AllocationShare": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "allocated",
            "idle",
            "system",
            "unallocated"
          ],
          "title": "Category",
          "type": "string"
        },
        "container": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 18,
          "ge": 0,
          "le": 1,
          "max_digits": 19,
          "title": "Fraction"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "row_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Row Id",
          "type": "string"
        },
        "workload_uid": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Uid"
        }
      },
      "required": [
        "row_id",
        "fraction",
        "category"
      ],
      "title": "AllocationShare",
      "type": "object"
    },
    "CostAllocation": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "reviewed-shares",
          "title": "Basis",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "profile": {
          "const": "reviewed-allocation-shares-v1",
          "default": "reviewed-allocation-shares-v1",
          "title": "Profile",
          "type": "string"
        },
        "shared_idle": {
          "const": false,
          "title": "Shared Idle",
          "type": "boolean"
        },
        "shares": {
          "items": {
            "$ref": "#/$defs/AllocationShare"
          },
          "maxItems": 100000,
          "title": "Shares",
          "type": "array"
        },
        "source": {
          "enum": [
            "aks-cost-analysis",
            "opencost",
            "kubecost"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_reference",
        "basis",
        "shared_idle",
        "period",
        "shares"
      ],
      "title": "CostAllocation",
      "type": "object"
    },
    "CostImport": {
      "additionalProperties": false,
      "properties": {
        "allocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostAllocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/CostResourceBinding"
          },
          "maxItems": 100000,
          "title": "Bindings",
          "type": "array"
        },
        "cost_basis": {
          "const": "amortized",
          "title": "Cost Basis",
          "type": "string"
        },
        "export_complete": {
          "default": false,
          "title": "Export Complete",
          "type": "boolean"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CostRow"
          },
          "maxItems": 100000,
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observed_at": {
          "format": "date-time",
          "title": "Source Observed At",
          "type": "string"
        },
        "source_profile": {
          "const": "azure-cost-details-projection-v1",
          "title": "Source Profile",
          "type": "string"
        },
        "source_reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Reference",
          "type": "string"
        },
        "subscription_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Subscription Ids",
          "type": "array"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "source_profile",
        "cost_basis",
        "tenant_id",
        "subscription_ids",
        "period",
        "source_reference",
        "source_observed_at",
        "rows"
      ],
      "title": "CostImport",
      "type": "object"
    },
    "CostPeriod": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CostPeriod",
      "type": "object"
    },
    "CostResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "cluster_resource_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cluster Resource Id",
          "type": "string"
        },
        "cluster_uid": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Cluster Uid",
          "type": "string"
        },
        "pool_resource_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pool Resource Id"
        },
        "reference": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reference",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "cluster_resource_id",
        "cluster_uid",
        "reference"
      ],
      "title": "CostResourceBinding",
      "type": "object"
    },
    "CostRow": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 12,
          "max_digits": 30,
          "title": "Amount"
        },
        "benefit_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benefit Id"
        },
        "charge_category": {
          "enum": [
            "compute",
            "storage",
            "network",
            "other"
          ],
          "title": "Charge Category",
          "type": "string"
        },
        "charge_type": {
          "enum": [
            "Usage",
            "Purchase",
            "Refund",
            "UnusedReservation",
            "UnusedSavingsPlan",
            "RoundingAdjustment"
          ],
          "title": "Charge Type",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "pricing_model": {
          "enum": [
            "OnDemand",
            "Reservation",
            "SavingsPlan",
            "Spot"
          ],
          "title": "Pricing Model",
          "type": "string"
        },
        "reservation_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Id"
        },
        "subscription_id": {
          "format": "uuid",
          "title": "Subscription Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "subscription_id",
        "resource_id",
        "period",
        "amount",
        "currency",
        "charge_category",
        "charge_type",
        "pricing_model"
      ],
      "title": "CostRow",
      "type": "object"
    },
    "CurrencyReconciliation": {
      "additionalProperties": false,
      "properties": {
        "allocated": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Allocated"
        },
        "allocation_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allocation Coverage"
        },
        "by_attribution": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "allocated",
              "idle",
              "system",
              "unallocated"
            ]
          },
          "title": "By Attribution",
          "type": "object"
        },
        "by_charge": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "compute",
              "storage",
              "network",
              "other"
            ]
          },
          "title": "By Charge",
          "type": "object"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "matched": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Matched"
        },
        "positive_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Positive Cost"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Total"
        },
        "unmatched": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Unmatched"
        }
      },
      "required": [
        "currency",
        "total",
        "positive_cost",
        "matched",
        "unmatched",
        "allocated",
        "allocation_coverage",
        "by_charge",
        "by_attribution"
      ],
      "title": "CurrencyReconciliation",
      "type": "object"
    },
    "ReconciledCostRow": {
      "additionalProperties": false,
      "properties": {
        "allocations": {
          "items": {
            "$ref": "#/$defs/ReconciledShare"
          },
          "title": "Allocations",
          "type": "array"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostResourceBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "original": {
          "$ref": "#/$defs/CostRow"
        },
        "unallocated": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Unallocated"
        }
      },
      "required": [
        "original",
        "binding",
        "allocations",
        "unallocated",
        "issues"
      ],
      "title": "ReconciledCostRow",
      "type": "object"
    },
    "ReconciledShare": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "original": {
          "$ref": "#/$defs/AllocationShare"
        }
      },
      "required": [
        "original",
        "amount"
      ],
      "title": "ReconciledShare",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "currencies": {
      "items": {
        "$ref": "#/$defs/CurrencyReconciliation"
      },
      "title": "Currencies",
      "type": "array"
    },
    "estimated_monthly_savings": {
      "default": null,
      "title": "Estimated Monthly Savings",
      "type": "null"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/CostImport"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "maximum_evidence_age_hours": {
      "exclusiveMinimum": 0,
      "maximum": 8760,
      "title": "Maximum Evidence Age Hours",
      "type": "integer"
    },
    "minimum_allocation_coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "decimal_places": 18,
      "ge": 0,
      "le": 1,
      "max_digits": 19,
      "title": "Minimum Allocation Coverage"
    },
    "notice": {
      "const": "Reconciled attribution is not avoidable cost, realized savings, source attestation or change approval.",
      "default": "Reconciled attribution is not avoidable cost, realized savings, source attestation or change approval.",
      "title": "Notice",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ReconciledCostRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "status": {
      "enum": [
        "reconciled",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "evaluated_at",
    "input_digest",
    "snapshot_digest",
    "evidence",
    "minimum_allocation_coverage",
    "maximum_evidence_age_hours",
    "status",
    "reason_codes",
    "rows",
    "currencies"
  ],
  "title": "CostReconciliation",
  "type": "object"
}
