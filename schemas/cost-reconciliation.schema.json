            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "valid_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostPeriod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
