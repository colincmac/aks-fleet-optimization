          "type": "string"
        },
        "granularity": {
          "anyOf": [
            {
              "enum": [
                "resource",
                "cluster",
                "namespace",
                "workload",
                "container",
                "asset"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Granularity"
