          "default": null,
          "title": "Reservation Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Id"
        },
        "source_category": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Category",
          "type": "string"
        },
        "subscription_id": {
          "format": "uuid",
          "title": "Subscription Id",
          "type": "string"
