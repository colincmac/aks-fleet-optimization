          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CostPeriod"
        },
        "pricing_model": {
          "anyOf": [
            {
              "enum": [
                "OnDemand",
                "Reservation",
                "SavingsPlan",
                "Spot",
                "Dynamic",
                "Committed",
                "Other"
