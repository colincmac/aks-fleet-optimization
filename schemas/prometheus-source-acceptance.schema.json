{
  "$defs": {
    "PrometheusQueryAcceptance": {
      "additionalProperties": false,
      "properties": {
        "duplicate_series": {
          "minimum": 0,
          "title": "Duplicate Series",
          "type": "integer"
        },
        "expected_entities": {
          "minimum": 1,
          "title": "Expected Entities",
          "type": "integer"
        },
        "expression_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expression Digest",
          "type": "string"
        },
        "latest_sample_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Sample At"
        },
        "matched_expected_entities": {
          "minimum": 0,
          "title": "Matched Expected Entities",
          "type": "integer"
        },
        "observed_series": {
          "minimum": 0,
          "title": "Observed Series",
          "type": "integer"
        },
        "query_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Query Id",
          "type": "string"
        },
        "query_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Query Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reason Codes",
          "type": "array"
        },
        "required_label_keys": {
          "items": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Required Label Keys",
          "type": "array"
        },
        "status": {
          "enum": [
            "accepted",
            "partial",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mCPU",
            "MiB",
            "ratio",
            "events",
            "pods",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "query_version",
        "expression_digest",
        "unit",
        "status",
        "required_label_keys",
        "observed_series",
        "matched_expected_entities",
        "expected_entities",
        "duplicate_series"
      ],
      "title": "PrometheusQueryAcceptance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "const": "executed-prometheus-source",
      "default": "executed-prometheus-source",
      "title": "Basis",
      "type": "string"
    },
    "cluster_resource_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Cluster Resource Id",
      "type": "string"
    },
    "cluster_uid": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Cluster Uid",
      "type": "string"
    },
    "configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Digest",
      "type": "string"
    },
    "endpoint": {
      "default": null,
      "title": "Endpoint",
      "type": "null"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "live_time_picker_quality": {
      "const": "unknown",
      "default": "unknown",
      "title": "Live Time Picker Quality",
      "type": "string"
    },
    "notice": {
      "const": "Fixed-window executed evidence only; not endpoint authentication, mutable live datasource quality, finding eligibility, scheduler fit, change approval or savings.",
      "default": "Fixed-window executed evidence only; not endpoint authentication, mutable live datasource quality, finding eligibility, scheduler fit, change approval or savings.",
      "title": "Notice",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Reason Codes",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/PrometheusQueryAcceptance"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source",
      "type": "string"
    },
    "source_profile_id": {
      "enum": [
        "identity-enriched",
        "cadvisor-ksm"
      ],
      "title": "Source Profile Id",
      "type": "string"
    },
    "source_profile_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Source Profile Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Step Seconds",
      "type": "integer"
    },
    "tenant_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Tenant Id",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "cluster_resource_id",
    "cluster_uid",
    "source",
    "source_profile_id",
    "source_profile_version",
    "evaluated_at",
    "window_start",
    "window_end",
    "step_seconds",
    "status",
    "input_digest",
    "configuration_digest",
    "records"
  ],
  "title": "PrometheusSourceAcceptance",
  "type": "object"
}
