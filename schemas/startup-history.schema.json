          "type": "string"
        },
        "characterized_versions": {
          "additionalProperties": {
            "items": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
