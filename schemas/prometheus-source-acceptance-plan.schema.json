{
  "$defs": {
    "PrometheusQueryRequest": {
      "additionalProperties": false,
      "properties": {
        "expected_label_sets": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Expected Label Sets",
          "type": "array"
        },
        "query": {
          "$ref": "#/$defs/RenderedQuery"
        },
        "required_label_keys": {
          "items": {
            "type": "string"
          },
          "title": "Required Label Keys",
          "type": "array"
        },
        "unit": {
          "enum": [
            "mCPU",
            "MiB",
            "ratio",
            "events",
            "pods",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "query",
        "unit",
        "required_label_keys",
        "expected_label_sets"
      ],
      "title": "PrometheusQueryRequest",
      "type": "object"
    },
    "RenderedQuery": {
      "additionalProperties": false,
      "properties": {
        "entity_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Entity Digest",
          "type": "string"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "expression_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expression Digest",
          "type": "string"
        },
        "metric": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Step Seconds",
          "type": "integer"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "version",
        "source",
        "expression",
        "expression_digest",
        "entity_digest",
        "step_seconds"
      ],
      "title": "RenderedQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "const": "prometheus-source-acceptance-plan",
      "default": "prometheus-source-acceptance-plan",
      "title": "Basis",
      "type": "string"
    },
    "cluster_resource_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Cluster Resource Id",
      "type": "string"
    },
    "cluster_uid": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Cluster Uid",
      "type": "string"
    },
    "configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Digest",
      "type": "string"
    },
    "notice": {
      "const": "Expected identity roster and installed query plan only; not live consent, source authentication, finding eligibility, approval or savings.",
      "default": "Expected identity roster and installed query plan only; not live consent, source authentication, finding eligibility, approval or savings.",
      "title": "Notice",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/PrometheusQueryRequest"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Requests",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source",
      "type": "string"
    },
    "source_profile_id": {
      "enum": [
        "identity-enriched",
        "cadvisor-ksm"
      ],
      "title": "Source Profile Id",
      "type": "string"
    },
    "source_profile_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Source Profile Version",
      "type": "string"
    },
    "step_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Step Seconds",
      "type": "integer"
    },
    "tenant_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Tenant Id",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "cluster_resource_id",
    "cluster_uid",
    "source",
    "source_profile_id",
    "source_profile_version",
    "window_start",
    "window_end",
    "step_seconds",
    "configuration_digest",
    "requests"
  ],
  "title": "PrometheusSourceAcceptancePlan",
  "type": "object"
}
