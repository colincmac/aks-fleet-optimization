{
  "$defs": {
    "CollectionError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unauthorized",
            "forbidden",
            "timeout",
            "throttled",
            "unavailable",
            "invalid-response",
            "response-budget-exceeded",
            "identity-mismatch"
          ],
          "title": "Code",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "code"
      ],
      "title": "CollectionError",
      "type": "object"
    },
    "CollectionStatus": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "CollectionStatus",
      "type": "string"
    },
    "CollectorResult": {
      "additionalProperties": false,
      "properties": {
        "collector": {
          "minLength": 1,
          "title": "Collector",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "completed_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Scope",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/CollectionError"
          },
          "title": "Errors",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "pagination_complete": {
          "default": false,
          "title": "Pagination Complete",
          "type": "boolean"
        },
        "requested_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Scope",
          "type": "array"
        },
        "retry_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Observed At"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CollectionStatus"
        }
      },
      "required": [
        "collector",
        "status",
        "requested_scope",
        "started_at",
        "completed_at"
      ],
      "title": "CollectorResult",
      "type": "object"
    },
    "NodeReservationAudit": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "node_name": {
          "minLength": 1,
          "title": "Node Name",
          "type": "string"
        },
        "node_uid": {
          "minLength": 1,
          "title": "Node Uid",
          "type": "string"
        },
        "observed_cpu_request_mcpu": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Cpu Request Mcpu"
        },
        "observed_memory_request_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Memory Request Mib"
        },
        "observed_nonterminal_pod_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Nonterminal Pod Count"
        },
        "pod_uids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Pod Uids",
          "type": "array"
        }
      },
      "required": [
        "node_uid",
        "node_name",
        "pod_uids"
      ],
      "title": "NodeReservationAudit",
      "type": "object"
    },
    "PodNodeConstraintReview": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "additionalProperties": {
            "enum": [
              "matched",
              "excluded",
              "unknown"
            ],
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "node_selector",
              "required_node_affinity",
              "hard_taints",
              "cordon"
            ]
          },
          "title": "Constraints",
          "type": "object"
        },
        "issues": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "node_uid": {
          "minLength": 1,
          "title": "Node Uid",
          "type": "string"
        },
        "pod_uid": {
          "minLength": 1,
          "title": "Pod Uid",
          "type": "string"
        },
        "status": {
          "enum": [
            "no_observed_exclusion",
            "excluded_by_observed_constraint",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "pod_uid",
        "node_uid",
        "constraints",
        "status"
      ],
      "title": "PodNodeConstraintReview",
      "type": "object"
    },
    "SchedulingCompletenessAudit": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "sanitized-metadata-reservation-audit",
          "default": "sanitized-metadata-reservation-audit",
          "title": "Basis",
          "type": "string"
        },
        "cluster_resource_id": {
          "minLength": 1,
          "title": "Cluster Resource Id",
          "type": "string"
        },
        "cluster_uid": {
          "minLength": 1,
          "title": "Cluster Uid",
          "type": "string"
        },
        "collection": {
          "$ref": "#/$defs/CollectorResult"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "fit_status": {
          "const": "blocked",
          "default": "blocked",
          "title": "Fit Status",
          "type": "string"
        },
        "issues": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "maximum_source_age_seconds": {
          "exclusiveMinimum": 0,
          "title": "Maximum Source Age Seconds",
          "type": "integer"
        },
        "metadata_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Digest",
          "type": "string"
        },
        "metadata_generated_at": {
          "format": "date-time",
          "title": "Metadata Generated At",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeReservationAudit"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pending_pod_uids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Pending Pod Uids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "terminal_pod_uids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Terminal Pod Uids",
          "type": "array"
        },
        "unobserved_dimensions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unobserved Dimensions",
          "type": "array"
        },
        "unresolved_assignment_pod_uids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Assignment Pod Uids",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "cluster_resource_id",
        "cluster_uid",
        "metadata_digest",
        "metadata_generated_at",
        "evaluated_at",
        "maximum_source_age_seconds",
        "collection",
        "nodes",
        "pending_pod_uids",
        "unresolved_assignment_pod_uids",
        "terminal_pod_uids",
        "issues"
      ],
      "title": "SchedulingCompletenessAudit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "admission_blockers": {
      "default": [
        "producer_completeness_unverified",
        "scheduler_configuration_unverified"
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "producer_completeness_unverified",
          "type": "string"
        },
        {
          "const": "scheduler_configuration_unverified",
          "type": "string"
        }
      ],
      "title": "Admission Blockers",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/SchedulingCompletenessAudit"
    },
    "basis": {
      "const": "current-retained-hard-constraint-review",
      "default": "current-retained-hard-constraint-review",
      "title": "Basis",
      "type": "string"
    },
    "fit_status": {
      "const": "blocked",
      "default": "blocked",
      "title": "Fit Status",
      "type": "string"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/PodNodeConstraintReview"
      },
      "maxItems": 100000,
      "title": "Pairs",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unassessed_dimensions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unassessed Dimensions",
      "type": "array"
    }
  },
  "required": [
    "audit",
    "pairs"
  ],
  "title": "SchedulingPlacementReview",
  "type": "object"
}
